{
  "name": "dsh-plugin-cicd",
  "version": "0.8.12",
  "private": true,
  "type": "module",
  "description": "DSH CI/CD pipeline: commit to GitHub, remote SSH build, image push, and Kubernetes deployment.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./dist/host/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/*.js",
    "dist/host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:client": "node tests/client-smoke.mjs",
    "smoke:host": "node tests/host-smoke.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke:host && pnpm smoke:client"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
